{
  "version": 2,
  "buildCommand": "pnpm run build:vercel-api && vite build",
  "outputDirectory": "dist/public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    },
    "api/patient_import.py": {
      "maxDuration": 15,
      "excludeFiles": "{node_modules,client,dist,server,shared,drizzle,docs,patches,attached_assets}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/patient_import",
      "destination": "/api/patient_import"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|storage/|images/|manus-storage/|assets/|ocr/).*)",
      "destination": "/index.html"
    }
  ]
}
