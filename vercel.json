{
  "version": 2,
  "buildCommand": "pnpm run build:vercel-api && vite build",
  "outputDirectory": "dist/public",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    },
    "api/py.py": {
      "maxDuration": 10,
      "excludeFiles": "{node_modules,client,dist,server,shared,drizzle,docs,scripts,data_import,graphify-out,patches,attached_assets}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/py/(.*)",
      "destination": "/api/py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|storage/|images/|manus-storage/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
