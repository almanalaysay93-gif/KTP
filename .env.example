# ==========================================
# SKTI NurseTrack Environment Variables
# ==========================================

# 1. Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI to add in Google Console: https://nodandnatracker.vercel.app/api/oauth/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 2. Session / JWT Secret
# A random secret string used to sign session cookies
JWT_SECRET=your-random-32-character-secret-key

# 3. Admin User Configuration
# Comma-separated list of emails with admin access
OWNER_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com,supervisor@example.com

# 4. Database Connection (MySQL / TiDB / Supabase / PlanetScale)
# Required for persistent production storage on Vercel
DATABASE_URL=mysql://user:password@host:3306/database_name

# 5. (Optional) AWS S3 for Document & Photo Uploads
# AWS_REGION=ap-southeast-1
# S3_BUCKET_NAME=your-s3-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# 6. (Optional) OpenRouter AI for Smart Import document extraction
# OPENROUTER_API_KEY=sk-or-v1-...

# 7. Resend Email Dispatch
# Get API key from https://resend.com/api-keys
# In sandbox mode, sender must be onboarding@resend.dev and delivers to Resend account owner.
# Once your domain is verified on https://resend.com/domains, set EMAIL_FROM to your verified address.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="SKTI NurseTrack <onboarding@resend.dev>"

# 8. Scheduled Reminders & Webhook Security
# CRON_SECRET secures GET /api/cron/daily-reminders (min 16 characters)
CRON_SECRET=your-random-16-character-cron-secret
APP_URL=https://nodandnatracker.vercel.app
