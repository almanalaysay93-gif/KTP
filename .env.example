# Local KTP: no Supabase, Google account, cloud keys or .env setup required.
# Install dependencies, then run: pnpm local
# First launch opens a local password setup screen.
# The launcher generates a private database password and session key automatically.

# Optional: override the local browser port.
PORT=3000

# Optional: absolute directory for the database and local credentials.
# Default: Windows %LOCALAPPDATA%/KTP; macOS ~/Library/Application Support/KTP;
# Linux ~/.local/share/ktp (or $XDG_DATA_HOME/ktp).
# LOCAL_APP_DATA_DIR=/absolute/path/to/ktp-data

# Local launches ignore hosted DATABASE_URL, Google, Resend and S3 configuration.
# Do not place your login password in this file.
